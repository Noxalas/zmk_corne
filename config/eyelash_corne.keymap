#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <2000>;
};

 / {
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    macros {
        arrow_thin: arrow_thin {
            compatible = "zmk,behavior-macro";
            label = "ARROW_THIN";
            #binding-cells = <0>;
            bindings =
                <&kp MINUS>, <&kp MINUS>, <&kp GT>;
        };

        arrow_thick: arrow_thick {
            compatible = "zmk,behavior-macro";
            label = "ARROW_THICK";
            #binding-cells = <0>;
            bindings =
                <&kp EQUAL>, <&kp EQUAL>, <&kp GT>;
        };
    };

    behaviors {
        arrow_morph: arrow_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ARROW_MORPH";
            #binding-cells = <0>;
            bindings = <&arrow_thin &arrow_thick>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "BASE";
            display-name = "BASE";
            bindings = <
&kp TAB     &kp Q      &kp W      &kp F       &kp P       &kp B                            &kp C_VOL_UP                &kp J           &kp L        &kp U       &kp Y      &kp SEMI   &kp BSPC
&kp LSHIFT  &mt LGUI A &mt LALT R &mt LCTRL S &mt LSHFT T &kp G                 &kp C_PREV &kp C_PLAY_PAUSE &kp C_NEXT &kp M           &mt RSHIFT N &mt RCTRL E &mt RALT I &mt RGUI O &kp SQT
&kp LCTRL   &kp Z      &kp X      &kp C       &kp D       &kp V     &kp SPACE              &kp C_VOL_DN                &kp K           &kp H        &kp COMMA   &kp DOT    &kp FSLH   &kp BSLH
                                  &kp LGUI    &kp TAB     &lt 1 SPACE                                                &lt 2 RET     &kp ESC      &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        nav_layer {
            label = "NAV";
            display-name = "NAV";
            bindings = <
&trans &kp ESC   &kp EXCL  &kp UP   &kp EQUAL &kp LBRC                           &mmv MOVE_UP                   &kp RBRC &kp N7 &kp N8 &kp N9 &kp KP_PLUS     &kp BSPC
&trans &kp LSHFT &kp LEFT  &kp DOWN &kp RIGHT &kp LBKT            &mmv MOVE_LEFT &mkp LCLK      &mmv MOVE_RIGHT &kp RBKT &kp N4 &kp N5 &kp N6 &kp KP_MINUS    &kp PG_UP
&trans &kp DEL   &kp PG_UP &kp CAPS &kp PG_DN &kp LPAR &kp C_MUTE                &mmv MOVE_DOWN                 &kp RPAR &kp N1 &kp N2 &kp N3 &kp KP_MULTIPLY &kp PG_DN
                           &trans   &trans    &trans                                                            &mo 3  &kp N0 &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        sim_layer {
            label = "SYM";
            display-name = "SYM";
            bindings = <
&trans &kp GRAVE &kp LT   &kp GT            &kp MINUS        &kp BACKSLASH              &mmv MOVE_UP        &kp CARET &kp LBRC &kp RBRC &kp DOLLAR &arrow_morph &kp BSPC
&trans &kp EXCL  &kp STAR &kp SLASH         &kp EQUAL        &kp AMPERSAND  &mmv MOVE_LEFT &mkp LCLK &mmv MOVE_RIGHT &kp HASH &kp LPAR &kp RPAR &kp SEMI &kp DQT &trans
&trans &kp TILDE &kp PLUS &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp PERCENT &trans           &mmv MOVE_DOWN     &kp AT   &kp COLON &kp COMMA &kp DOT &kp APOS &kp TILDE
                              &trans &trans &kp SPACE                                     &kp RET &trans &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        adj_layer {
            label = "ADJ";
            display-name = "ADJ";
            bindings = <
&studio_unlock &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                    &mmv MOVE_UP        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&bootloader    &bt BT_CLR &bt BT_SEL 3 &bt BT_SEL 4 &trans &mkp MB4      &mmv MOVE_LEFT &mkp LCLK &mmv MOVE_RIGHT &bootloader &mkp LCLK &mkp MCLK &mkp RCLK &kp PRINTSCREEN &kp F12
&sys_reset     &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &mkp MB5 &kp C_MUTE         &mmv MOVE_DOWN     &trans &trans &trans &sys_reset &kp SCROLLLOCK &kp PAUSE_BREAK
                             &trans &trans &trans                                    &trans &trans &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
