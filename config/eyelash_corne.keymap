#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    macros {
        arrow_thin {
            compatible = "zmk, behavior-macro";
            label = "ARROW_THIN";
            #binding-cells = <0>;
            bindings =
                <&kp MINUS>, <&kp MINUS>, <&kp GT>;
        };
        arrow_thick {
            compatible = "zmk, behavior-macro";
            label = "ARROW_THICK";
            #binding-cells = <0>;
            bindings =
                <&kp EQUAL>, <&kp EQUAL>, <&kp GT>;
        };
    };

    behaviors {
        arrow_morph: arrow_morph {
            compatible = "zmk, behavior-mod-morph";
            label = "ARROW_MORPH";
            #binding-cells = <0>;
            bindings = <&arrow_thin &arrow_thick>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F     &kp P  &kp B                               &kp UP                &kp J        &kp L  &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp LSHIFT &kp A  &kp R  &kp S     &kp T  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp M        &kp N  &kp E      &kp I    &kp O     &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp D  &kp V        &kp SPACE              &kp DOWN              &kp K        &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &kp SPACE                                               &lt 3 ENTER  &mo 2  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp KP_SLASH &kp N7 &kp N8 &kp N9 &kp KP_ASTERISK                          &mmv MOVE_UP        &none &none    &none    &none  &kp HOME  &kp BSPC
&trans  &kp KP_MINUS &kp N4 &kp N5 &kp N6 &kp KP_PLUS        &mmv MOVE_LEFT &mkp LCLK &mmv MOVE_RIGHT &none &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_UP
&trans  &kp X  &kp N1 &kp N2 &kp N3 &kp PERCENT &kp C_MUTE         &mmv MOVE_DOWN               &none &none    &none    &none  &kp END   &kp PG_DN
                                     &trans &trans &kp 0                                              &kp INS &kp DEL &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp GRAVE &kp LT   &kp GT           &kp MINUS         &kp PIPE                           &mmv MOVE_UP               &kp CARET &kp LEFT_BRACE &kp RIGHT_BRACE &kp DOLLAR &arrow_morph &kp BSPC
&trans  &kp EXCL  &kp STAR &kp SLASH        &kp EQUAL         &kp AMPERSAND      &mmv MOVE_LEFT  &mkp LCLK &mmv MOVE_RIGHT  &kp HASH &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp SEMI &kp DOUBLE_QUOTES &trans
&trans  &kp TILDE &kp PLUS &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp PERCENT &trans                 &mmv MOVE_DOWN             &kp AT &kp COLON &kp COMMA &kp DOT &kp APOS &kp TILDE
                                            &trans &trans &kp SPACE                                                                  &kp RET &trans &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "FNC";
            bindings = <
&studio_unlock &kp F1 &kp F2       &kp F3       &kp F4       &kp F5                                  &mmv MOVE_UP              &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&bootloader    &trans &bt BT_SEL 3 &bt BT_SEL 4 &trans       &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK &mmv MOVE_RIGHT &bootloader &mkp LCLK &mkp MCLK &mkp RCLK &kp PRINTSCREEN &kp F12
&sys_reset     &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &mkp MB5 &kp C_MUTE                     &mmv MOVE_DOWN            &trans &trans &trans &sys_reset &kp SCROLLLOCK &kp PAUSE_BREAK
                                   &trans &trans &trans                                                                        &trans &trans &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

    }; 
}; 
